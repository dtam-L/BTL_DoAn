# ==========================================
# Biến môi trường cho backend (KHÔNG commit file này lên Git!)
# Đổi tên file thành .env trước khi dùng
# ==========================================

# MongoDB connection string
# Dùng MongoDB Atlas (miễn phí): https://www.mongodb.com/atlas
MONGO_URI=mongodb://localhost:27017

# Hoặc dùng Atlas (thay <username>, <password>, <cluster>):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/

# Tên database và collection
DB_NAME=face_attendance
COL_NAME=students

# Ngưỡng nhận diện (lấy từ kết quả Giai đoạn 1)
THRESHOLD=0.9
